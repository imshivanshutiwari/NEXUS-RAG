class PGVectorIndexer:
  PostgreSQL + pgvector with HNSW index.
  HNSW params: m=16, ef_construction=64
  Distance: cosine
  
  schema:
    CREATE EXTENSION IF NOT EXISTS vector;
    CREATE TABLE documents (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      content TEXT NOT NULL,
      embedding vector(1024),
      metadata JSONB,
      source VARCHAR(50),
      created_at TIMESTAMP DEFAULT NOW(),
      chunk_index INTEGER,
      doc_id VARCHAR(255)
    );
    CREATE INDEX ON documents USING hnsw
      (embedding vector_cosine_ops)
      WITH (m=16, ef_construction=64);
    
  methods:
    insert_documents(docs, embeddings)
    similarity_search(query_vec, k=20,
                      filter_metadata=None) -> List[Document]
    hybrid_search(query_vec, bm25_scores,
                  k=10) -> List[Document]  ← RRF fusion

<span style="color:#44aaff;font-weight:700">── retrieval/hybrid_retriever.py ──</span>
class HybridRetriever:
  Combines BM25 sparse + pgvector dense via RRF fusion.
  
  Reciprocal Rank Fusion:
    score(d) = Σ 1/(k + rank_i(d))
    k = 60 (standard RRF constant)
    
  methods:
    retrieve(query: str, k: int = 20) -> List[ScoredDocument]
      1. dense_results = dense_retriever.search(query, k*2)
      2. sparse_results = bm25_retriever.search(query, k*2)
      3. fused = rrf_fusion(dense_results, sparse_results, k=60)
      4. return top-k fused results
    rrf_fusion(dense, sparse, k=60) -> List[ScoredDocument]
    update_weights(dense_w: float, sparse_w: float)
      ← adaptive weighting based on query type

<span style="color:#44aaff;font-weight:700">── retrieval/colbert_reranker.py ──</span>
class ColBERTReranker:
  Late interaction reranking using ColBERT.
  
  ColBERT MaxSim:
    score(q,d) = Σ_qi max_dj cos(E_q(qi), E_d(dj))
    
  methods:
    rerank(query: str,
           documents: List[Document],
           top_k: int = 5) -> List[ScoredDocument]
      1. Encode query tokens: q_embeddings (Lq, 128)
      2. Encode doc tokens: d_embeddings (Ld, 128)
      3. Compute MaxSim for each query token
      4. Sum MaxSim scores → final score
    batch_rerank(queries, doc_lists) -> List[List[ScoredDocument]]

<span style="color:#44aaff;font-weight:700">── retrieval/query_expander.py ──</span>
class QueryExpander:
  HyDE + Multi-query expansion.
  
  HyDE (Hypothetical Document Embeddings):
    Generate hypothetical answer → embed it → retrieve
    
  methods:
    hyde_expand(query: str) -> str
      prompt = "Write a passage that answers: {query}"
      hypothetical_doc = bedrock.generate(prompt)
      return hypothetical_doc
    multi_query_expand(query: str,
                       n: int = 3) -> List[str]
      prompt = "Generate {n} different versions of: {query}"
      return parse_list(bedrock.generate(prompt))
    expand_and_retrieve(query: str) -> List[Document]
      queries = [query] + multi_query_expand(query)
      hyde_doc = hyde_expand(query)
      all_results = []
      for q in queries:
        all_results.extend(hybrid_retriever.retrieve(q))
      return deduplicate_and_rank(all_results)

